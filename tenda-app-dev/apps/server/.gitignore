# vscode
.vscode
*code-workspace

# Profiler output — 0x and clinic, both of which write into the package ROOT.
# ANCHORED with a leading slash, and that matters: a pattern with no slash
# matches a path SEGMENT at any depth, so the unanchored `profile-*`/`profile*`
# these replace silently swallowed test/integration/profile-completeness.test.ts
# — the file existed, its suite passed locally, and it would simply never have
# been committed. Anything named profile* under src/ or test/ is source.
/profile*
*clinic*
*flamegraph*

# generated code
examples/typescript-server.js
test/types/index.js

# compiled app
dist
