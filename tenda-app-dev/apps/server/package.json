{
  "name": "tenda-server",
  "version": "1.0.0",
  "description": "tenda server",
  "main": "server.ts",
  "directories": {
    "test": "test"
  },
  "//test": "The gate's memory settings are sized from MEASUREMENT, and the binding consumer is NOT a test worker: c8's report pass merges ~1.7GB of raw V8 coverage JSON (306 files) in ONE process after the workers have exited, and it OOMs at 1536 and at 2560 (observed 2026-08-31, dying at 1523.8MB and 2548.1MB — right at each limit). 4096 is the value that completes it. --max-old-space-size applies to every child too (verified: node --test children report the inherited limit), so it cannot be tuned per phase. What DOES bound the worker phase is --test-concurrency: 4 workers at 4096 inside MemoryMax=8G could reach the cgroup wall and take the desktop down with it, which happened. At concurrency 2 with workers observed under 1.5GB each, the worker phase peaks near 3GB and the report near 3.5GB, so MemoryMax=6G bounds both and never approaches the 8G that crashed the box. Do not lower the heap without re-measuring coverage/tmp first.",
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && TS_NODE_TRANSPILE_ONLY=1 NODE_OPTIONS=--max-old-space-size=4096 systemd-run --user --scope -q -p MemoryMax=6G -p MemorySwapMax=0 c8 node --test --test-concurrency=2 -r ts-node/register \"test/**/*.test.ts\"",
    "test:unit": "TS_NODE_TRANSPILE_ONLY=1 node --test --test-concurrency=4 -r ts-node/register \"test/unit/**/*.test.ts\"",
    "test:file": "TS_NODE_TRANSPILE_ONLY=1 node --test -r ts-node/register",
    "test:coverage:gas-seed": "TS_NODE_TRANSPILE_ONLY=1 c8 --config .c8rc.gas-seed.json node --test --test-concurrency=2 -r ts-node/register \"test/unit/gas-seed.test.ts\" \"test/unit/gas-seed-trigger.test.ts\" \"test/unit/gas-seed-senders.test.ts\" \"test/unit/gas-seed-sender-evm.test.ts\" \"test/unit/chains/secrets-relayer.test.ts\" \"test/unit/seed-v2.test.ts\" \"test/unit/seed-v2-gas-seed.test.ts\" \"test/integration/gas-seed-store.test.ts\" \"test/integration/evm-gas-seed.anvil.test.ts\"",
    "test:coverage:contracts": "TS_NODE_TRANSPILE_ONLY=1 c8 --config .c8rc.contracts.json node --test --test-concurrency=4 -r ts-node/register \"test/unit/chains/contracts.test.ts\" \"test/unit/escrow-build-tx.test.ts\" \"test/unit/evm-verify-receipt.test.ts\" \"test/unit/evm-adapter.test.ts\" \"test/unit/evm-listener-polling.test.ts\" \"test/integration/chain-contracts-registry.test.ts\" \"test/integration/escrow-contract-stamp.test.ts\" \"test/integration/chains-plugin-boot.test.ts\" \"test/integration/listener-plugin-watch-set.test.ts\"",
    "start": "node dist/server.js",
    "build": "pnpm build:ts",
    "build:ts": "rm -rf dist && tsc && tsc-alias && cp -r src/assets dist/assets",
    "dev": "tsx watch src/server.ts",
    "type-check": "npx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed-v2.ts",
    "test:devnet:convergence": "set -a && . ./.env && set +a && RPC_URL=$CHAIN_SOLANA_DEVNET_RPC_URL node tests-devnet/convergence.mjs",
    "admin:bootstrap": "tsx src/scripts/bootstrap-super-admin.ts",
    "admin:grant-email": "tsx src/scripts/grant-admin-email.ts",
    "dedupe-wallets": "tsx src/scripts/dedupe-wallets.ts",
    "verify:celo-fee-currency": "tsx src/scripts/verify-celo-feecurrency.ts",
    "verify:gas-seed": "tsx src/scripts/verify-gas-seed.ts",
    "verify:relayed-funding": "tsx src/scripts/verify-relayed-funding.ts",
    "verify:relayed-funding-evm": "tsx src/scripts/verify-relayed-funding-evm.ts",
    "lint": "eslint .",
    "verify:agent-hire": "tsx src/scripts/agent-hire-e2e/main.ts"
  },
  "keywords": [],
  "author": "",
  "license": "BUSL-1.1",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/websocket": "^11.2.0",
    "@sentry/node": "^10.42.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tenda/shared": "workspace:*",
    "bs58": "^6.0.0",
    "bullmq": "^5.78.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "postgres": "^3.4.8",
    "tweetnacl": "^1.0.3",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.10.13",
    "ajv": "^8.18.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.4.1",
    "fastify-tsconfig": "^3.0.0",
    "litesvm": "0.3.3",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.1"
  }
}
