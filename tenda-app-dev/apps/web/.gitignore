# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files stay local; public-prefixed values are still deployment configuration
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright artifacts — traces, screenshots and error contexts from a failed
# run. They are per-run debris, sometimes hundreds of MB, and a failing run is
# exactly when someone is most likely to `git add -A`.
/test-results/
/playwright-report/
/blob-report/
