{
  "name": "web",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "scripts": {
    "dev-capped": "systemd-run --user --scope -p MemoryMax=6G -p MemorySwapMax=0 pnpm run dev",
    "dev": "NODE_ENV=development next dev -p 3200",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -p 3200",
    "type-check": "tsc --noEmit",
    "test": "NODE_ENV=test systemd-run --user --scope -q -p MemoryMax=4G -p MemorySwapMax=0 vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test systemd-run --user --scope -q -p MemoryMax=4G -p MemorySwapMax=0 vitest run --coverage",
    "gen:tokens": "tsx scripts/gen-web-tokens/main.ts",
    "gen:tokens:check": "tsx scripts/gen-web-tokens/main.ts --check",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@reown/appkit": "^1.8.21",
    "@reown/appkit-adapter-solana": "^1.8.21",
    "@reown/appkit-adapter-wagmi": "^1.8.21",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.2",
    "@tenda/shared": "workspace:*",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "wagmi": "^3.6.21",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "test-exclude": "^7.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
