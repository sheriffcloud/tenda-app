{
  "name": "@tenda/api-doc",
  "version": "0.0.1",
  "license": "BUSL-1.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "prepare": "pnpm run build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "type-check:test": "tsc -p test/tsconfig.json",
    "test": "tsc -p test/tsconfig.json && node --test -r ts-node/register \"test/**/*.test.ts\"",
    "test:coverage": "c8 node --test -r ts-node/register \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@tenda/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "ajv": "^8.18.0",
    "c8": "^10.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
