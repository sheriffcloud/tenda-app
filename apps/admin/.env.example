# ============================================================================
# Tenda admin dashboard environment — copy to .env.local and fill in.
# Next.js loads .env.local automatically; NEXT_PUBLIC_* vars are embedded in
# the client bundle (never put secrets behind that prefix).
#
# Auth is email-OTP + bearer token in localStorage (no Edge middleware, no
# server secrets) — the dashboard is a pure client of the Tenda API, so the
# API base URL is the only thing it needs to know.
# ============================================================================

# Base URL of the Tenda server API (host only; routes carry /v1).
# Local dev:   http://127.0.0.1:3000  (defaults to http://localhost:3000 if unset)
# Staging:     https://api-staging.tenda.so
# Production:  https://admin-api.tenda.so
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Reown (WalletConnect) project id — powers dispute-resolution signing in the
# admin. Reuse the same project id as mobile (EXPO_PUBLIC_REOWN_PROJECT_ID).
# When unset, the wallet layer stays inert and the sign UI shows
# "not configured on this deployment" (propose/reject still work).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Public origin of this admin deployment, used as Reown application metadata.
# Required only when NEXT_PUBLIC_REOWN_PROJECT_ID is set. This must be the real
# absolute http(s) origin for the deployment; no production domain is assumed.
# Local dev:
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100
