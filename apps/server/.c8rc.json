{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/db/migrations/**",
    "src/server.ts",
    "src/scripts/**",
    "src/features/fiat-rails/core/types.ts",
    "src/features/moderation/core/types.ts",
    "src/**/*.types.ts",
    "src/plugins/queue/payloads.ts",
    "src/features/alerts/channels/in-app/render/notice.ts",
    "src/**/*.d.ts"
  ],
  "reporter": ["text", "lcov"],
  "report-dir": "coverage",
  "clean": true,
  "check-coverage": true,
  "lines": 90,
  "branches": 90,
  "functions": 90,
  "statements": 90
}
