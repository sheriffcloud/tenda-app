# ============================================================================
# Tenda server environment — copy to .env and fill in.
#
# REQUIRED vars fail boot when missing (see REQUIRED_ENV_VARS in
# src/config.ts). Everything else is optional: unset = the feature is
# disabled or a documented default applies. Stage/step references map to
# the user-action task list (steps 1–13).
# ============================================================================

# ---------------------------------------------------------------------------
# Core (REQUIRED). Chain endpoints/keys are NOT here — see the Chains section.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/tenda
# Local integration tests only; must be a disposable database, never dev/prod.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/tenda_test
# ≥32 random chars in production
JWT_SECRET=your-jwt-secret-here
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Public base URL of THIS deployment, no trailing slash — asserted against
# the `URI:` line of signed auth messages (cross-deployment replay defense)
API_BASE_URL=https://api.tenda.example

# ---------------------------------------------------------------------------
# Core (optional — defaults in src/config.ts)
# ---------------------------------------------------------------------------
#NODE_ENV=development
#PORT=3000
# JWT lifetime, e.g. '7d', '24h' (default 7d)
#JWT_EXPIRES_IN=7d
# The platform fee is NOT an env var: it is read from the platform_config table, and each contract
# charges its own stored value. Change it with `pnpm --filter tenda-server fee:set <fee> <seeker>`;
# `fee:check` compares the two. (PLATFORM_FEE_BPS is retired and ignored.)

# The EVM address the shared DEMO agent posts as (#108). Set it and
# POST /v1/agent/demo-session hands anyone a bearer for that account, so a
# reviewer with no wallet reaches the real 402 terms instead of a 401. UNSET =
# no demo on this deployment and that route answers 503.
# An ADDRESS, never a key: terms are built FOR an address and signed BY its
# holder, so this is exactly enough to be quoted and not enough to spend.
#AGENT_DEMO_ADDRESS=0x0000000000000000000000000000000000000000
# How many unfunded drafts the demo account keeps (#147). Nothing deletes
# drafts, so the account keeps a RING: past this many, minting a new task
# discards its oldest. Well above the reviewers one round runs at once, small
# enough to bound the table. Positive integer; default 20.
#AGENT_DEMO_DRAFT_CAP=20

# Days an UNFUNDED draft (gig or exchange, human or agent) lives before the daily
# sweep discards it. A draft is minted before anything is funded and nothing else
# removes one a person walks away from. Never touches a funded escrow or a draft
# whose create is awaiting confirmation. Positive integer; default 7.
#DRAFT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Chains — per-deployment secrets, keyed by CAIP-2 id: CHAIN_<ID>_<FIELD>
# (id sanitised: ':'/'-' → '_', upper-cased). PUBLIC facts (confirmations,
# token addresses, gasPolicy) live in the shared CHAIN_MANIFEST, NOT here.
#
# A chain is ACTIVE iff its required fields are set; the server registers
# exactly the chains you configure (≥1 required, else boot fails). At most one
# chain per family may be active (BASE mainnet XOR Base Sepolia). And the
# manifest must declare the chain `status: 'live'` (#145): env for a chain the
# manifest still calls `planned` or `launching` is a boot error naming it.
#   - Solana required: RPC_URL + TREASURY_ADDR  (program id = the IDL artifact,
#     not an env var; listener = polling unless WEBHOOK_SECRET is set).
#   - EVM required:    RPC_URL + ESCROW_ADDR + TREASURY_ADDR.
#     Optional RPC_URL_FALLBACK: secondary endpoint (different provider); the
#     server fails over to it when the primary errors or exceeds 6s.
# Adding a chain (mainnet OR testnet) = uncomment a block + fill it in.
# ---------------------------------------------------------------------------
# --- solana:devnet (the default dev chain) ---
# ITS WEBSOCKET MUST WORK, not just its HTTP. web3.js confirms a transaction by
# subscribing to the signature over WS, and several providers hand out a key
# that authorises HTTP while the derived WS endpoint answers 401. When that
# happens confirmation degrades to blockhash-expiry polling and every gas-seed
# transfer takes ~30s instead of ~6s. MEASURED on devnet, both ways.
# The seed no longer LOSES money to this (the sender asks the chain whether the
# signature landed before reporting failure — see senders/solana.ts), but it is
# still 5x slower per claim, so prefer a provider whose WS is included.
CHAIN_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional independent provider used when the primary Solana RPC fails or times out.
# CHAIN_SOLANA_DEVNET_RPC_URL_FALLBACK=
# Platform treasury wallet (base58) — receives fees on approve_completion.
CHAIN_SOLANA_DEVNET_TREASURY_ADDR=4Nd1mYvK4Pm1x2HCmzCx5GQDV9KbpMK128bxgL5dVDU1
# Relayer hot wallet for agent funding (#18): fee payer of relayed creates, base58
# 64-byte secret (same class as GAS_SEED_KEY). Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_SOLANA_DEVNET_RELAYER_KEY=
# On-chain dispute-resolution authority (base58, Ed25519 — distinct from the EVM
# one). Optional: SET → the admin sign flow pre-flights the connected wallet.
#CHAIN_SOLANA_DEVNET_DISPUTE_ADMIN_ADDR=
# Devnet USDC mint. Unset = USDC_SOL not seeded → gig creation with USDC_SOL rejects.
#CHAIN_SOLANA_DEVNET_USDC_MINT=
# Helius webhook shared secret. SET → push intake; UNSET → polling fallback (#43).
#CHAIN_SOLANA_DEVNET_WEBHOOK_SECRET=
# base58 SECRET key of the funded gas-seed hot wallet (#40). SET → activates the
# manifest seed (0.007 SOL/user, gasSeedAmountRaw) and records this wallet's pubkey
# as the funder on db:seed; UNSET → seed stays dormant (gas_seed columns NULL).
#CHAIN_SOLANA_DEVNET_GAS_SEED_KEY=
#
# --- solana:mainnet (production — swap in for solana:devnet). Manifest status
#     is `planned`: setting these is a boot error (#145) until the escrow
#     program is deployed there and the manifest flipped to 'live'. ---
#CHAIN_SOLANA_MAINNET_RPC_URL=
#CHAIN_SOLANA_MAINNET_RPC_URL_FALLBACK=
#CHAIN_SOLANA_MAINNET_TREASURY_ADDR=
# Relayer hot wallet for agent funding (#18): fee payer of relayed creates, base58
# 64-byte secret (same class as GAS_SEED_KEY). Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_SOLANA_MAINNET_RELAYER_KEY=
#CHAIN_SOLANA_MAINNET_DISPUTE_ADMIN_ADDR=
#CHAIN_SOLANA_MAINNET_USDC_MINT=
#CHAIN_SOLANA_MAINNET_WEBHOOK_SECRET=
#CHAIN_SOLANA_MAINNET_GAS_SEED_KEY=
#
# --- eip155:8453 (BASE mainnet; #47). Manifest status is `planned`: setting
#     these is a boot error (#145) until TendaEscrow is deployed there and the
#     manifest flipped to 'live' — then all three required activate it. ---
#CHAIN_EIP155_8453_RPC_URL=
#CHAIN_EIP155_8453_RPC_URL_FALLBACK=
#CHAIN_EIP155_8453_ESCROW_ADDR=
# Block ESCROW_ADDR was deployed at (decimal). The EVM polling listener's exact
# first-run backfill start — no escrow event can predate it. Optional: unset
# limits a first run to a recency window (with a boot warning).
#CHAIN_EIP155_8453_ESCROW_DEPLOY_BLOCK=
#CHAIN_EIP155_8453_TREASURY_ADDR=
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_8453_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key.
#CHAIN_EIP155_8453_SWEEP_ENABLED=false
# On-chain dispute authority (0x, secp256k1 — distinct from the Solana one). Optional.
#CHAIN_EIP155_8453_DISPUTE_ADMIN_ADDR=
#CHAIN_EIP155_8453_PAYMASTER_URL=
#CHAIN_EIP155_8453_WEBHOOK_SECRET=
#
# --- eip155:84532 (Base Sepolia testnet — same family as BASE; activate one) ---
# Dress-rehearsal deployment — see contracts/evm/DEPLOY.md. Address + block come
# from contracts/evm/broadcast/Deploy.s.sol/84532/run-latest.json (2026-08-28),
# not from memory; the previous entry here named the 2026-07-18 deploy and was
# two redeploys stale. Verified live: feeBps() == 250.
#CHAIN_EIP155_84532_RPC_URL=https://sepolia.base.org
#CHAIN_EIP155_84532_RPC_URL_FALLBACK=
#CHAIN_EIP155_84532_ESCROW_ADDR=0x3780460189622E60cB7ec6e8e97038A386674B71
#CHAIN_EIP155_84532_ESCROW_DEPLOY_BLOCK=46089878
#CHAIN_EIP155_84532_TREASURY_ADDR=0x8792ed02eb25BEC8a9E8AD96C48fDD08FA39fFb5
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_84532_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key.
#CHAIN_EIP155_84532_SWEEP_ENABLED=false
#CHAIN_EIP155_84532_DISPUTE_ADMIN_ADDR=
#CHAIN_EIP155_84532_PAYMASTER_URL=
#CHAIN_EIP155_84532_WEBHOOK_SECRET=
#
# --- eip155:42220 (CELO mainnet — gas paid in USDC via feeCurrency adapter, no
#     paymaster; #49). Fee-currency adapter is a manifest constant (verified
#     on-chain), NOT an env var. ---
#CHAIN_EIP155_42220_RPC_URL=https://forno.celo.org
#CHAIN_EIP155_42220_RPC_URL_FALLBACK=
#CHAIN_EIP155_42220_ESCROW_ADDR=0x9D0193f7B607A15079bFE29aE28D69044F62c391
#CHAIN_EIP155_42220_ESCROW_DEPLOY_BLOCK=76748260
#CHAIN_EIP155_42220_TREASURY_ADDR=0x8792ed02eb25BEC8a9E8AD96C48fDD08FA39fFb5
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_42220_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key.
#CHAIN_EIP155_42220_SWEEP_ENABLED=false
#CHAIN_EIP155_42220_DISPUTE_ADMIN_ADDR=0x05A4750BC528e1Ff4A3d41540101537ac0500D28
#
# --- eip155:11142220 (Celo Sepolia testnet — same family/USDC-gas model as CELO;
#     activate one per family). Deploy TendaEscrow, then fill ESCROW_ADDR. ---
#CHAIN_EIP155_11142220_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
#CHAIN_EIP155_11142220_RPC_URL_FALLBACK=
#CHAIN_EIP155_11142220_ESCROW_ADDR=
#CHAIN_EIP155_11142220_ESCROW_DEPLOY_BLOCK=
#CHAIN_EIP155_11142220_TREASURY_ADDR=
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_11142220_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key.
#CHAIN_EIP155_11142220_SWEEP_ENABLED=false
#CHAIN_EIP155_11142220_DISPUTE_ADMIN_ADDR=
#
# --- ERC-8021 attribution, CELO family (#83) ---
# Stamps every Celo transaction Tenda builds with an attribution suffix so it is
# counted on Celo's public dashboard. Applies to BOTH Celo chains above: the
# code is a property of the project, not of a deployment, so it is keyed by
# manifest FAMILY (<FAMILY>_ATTRIBUTION_CODE) rather than by chain id.
#
# Unset = transactions go out untagged, which is a valid deployment and silent.
# It is also unrecoverable: the tag is part of the signed calldata, so there is
# NO backfill and anything sent untagged is permanently uncounted. Set this
# BEFORE the first Celo mainnet transaction, then confirm it landed with
# `pnpm --filter tenda-server verify:celo-tag <tx hash>`.
#
# Comma-separated for more than one code, which is the form Celo's own
# instructions use: our project code first, the code assigned at hackathon
# registration second. Only the assigned code is credited on their leaderboard.
# A code must match [a-z0-9_], be at most 32 bytes, and the joined list at most
# 255 bytes — anything else is a boot error naming this variable.
#CELO_ATTRIBUTION_CODE=celo_558f532905be,celo_yourassignedtag
#
# --- eip155:16602 (0G Galileo testnet — the agent-hire smoke chain, #20) ---
# No PAYMASTER_URL/WEBHOOK_SECRET below even though the loader accepts them:
# 0G's manifest gasPolicy is 'none' (no sponsorship) and no webhook provider
# covers this chain, so documenting them would advertise something that does
# nothing. Same choice the CELO pair above makes.
#
# ESCROW_ADDR + DEPLOY_BLOCK are from
# contracts/evm/broadcast/Deploy.s.sol/16602/run-latest.json (2026-08-28).
# Verified live: feeBps() == 250, treasury() == the TREASURY_ADDR below.
# NOTE the USDC here is the repo's own MockUSDCPermitV2, and its address is a
# MANIFEST constant, not an env var — see packages/shared/src/chains/manifest.ts.
# It happens to be 0x3780…4B71, the same address Base Sepolia's ESCROW_ADDR
# has: one deployer, one nonce, two chains. Different contracts entirely.
#CHAIN_EIP155_16602_RPC_URL=https://evmrpc-testnet.0g.ai
#CHAIN_EIP155_16602_RPC_URL_FALLBACK=
#CHAIN_EIP155_16602_ESCROW_ADDR=0x1cc520d175E8641ecD9a86Ed2dF7E4555154943D
#CHAIN_EIP155_16602_ESCROW_DEPLOY_BLOCK=51894463
#CHAIN_EIP155_16602_TREASURY_ADDR=0x8792ed02eb25BEC8a9E8AD96C48fDD08FA39fFb5
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_16602_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key.
#CHAIN_EIP155_16602_SWEEP_ENABLED=false
# Native-gas seed (#53a): the hot wallet that pays each user's one-time OG
# grant when they CLAIM it — never auto-sent (#53c-2). 0x-hex private key, and
# its OWN wallet, never the relayer key above: that float serves a flow an
# agent asked for, this one is an open-ended outflow to every user who asks.
# SET -> activates the manifest seed (0.01 OG/user, gasSeedAmountRaw) and
# records this wallet's address as the funder on db:seed; UNSET -> seed stays
# dormant (gas_seed columns NULL) and db:seed says so in its skipped list.
# The amount is MEASURED for this chain, not chosen: see the budget test at
# test/integration/evm-gas-budget.anvil.test.ts and OBSERVED_GAS_PRICE_WEI.
# A funded wallet here is watched — the gas-seed-balance-check repeatable
# raises a Slack alert at 5 remaining grants or fewer.
#CHAIN_EIP155_16602_GAS_SEED_KEY=
#CHAIN_EIP155_16602_DISPUTE_ADMIN_ADDR=
#
# --- eip155:5042002 (Arc testnet — PLANNED: nothing is deployed) and eip155:5042 (Arc mainnet) ---
# Arc's native gas token IS USDC, so the manifest gasPolicy is 'none' (the user pays gas
# in the native token) and there is no PAYMASTER_URL/WEBHOOK_SECRET to document, nor a
# GAS_SEED_KEY: no sponsorship is declared for either. The USDC is a manifest constant
# (the ERC-20 interface at 0x3600…0000, 6 decimals), not an env var.
#
# THE CHAIN DOES NOTHING UNTIL THESE ARE SET, and ESCROW_ADDR cannot be set until
# TendaEscrow is deployed there (pass TENDA_APPROVAL_WINDOW_S explicitly: the script
# default is 24h). The manifest also stays 'planned', so the secrets loader refuses to
# serve it, until a broadcast transaction with a receipt exists. The relayer pays gas in
# USDC (18-decimal NATIVE units): its balance reads must never be added to the ERC-20's.
#CHAIN_EIP155_5042002_RPC_URL=https://rpc.testnet.arc.io
#CHAIN_EIP155_5042002_RPC_URL_FALLBACK=
#CHAIN_EIP155_5042002_ESCROW_ADDR=
#CHAIN_EIP155_5042002_ESCROW_DEPLOY_BLOCK=
#CHAIN_EIP155_5042002_TREASURY_ADDR=
#CHAIN_EIP155_5042002_RELAYER_KEY=
#CHAIN_EIP155_5042002_SWEEP_ENABLED=false
#CHAIN_EIP155_5042002_DISPUTE_ADMIN_ADDR=
#CHAIN_EIP155_5042_RPC_URL=https://rpc.mainnet.arc.io
#CHAIN_EIP155_5042_RPC_URL_FALLBACK=
#CHAIN_EIP155_5042_ESCROW_ADDR=
#CHAIN_EIP155_5042_ESCROW_DEPLOY_BLOCK=
#CHAIN_EIP155_5042_TREASURY_ADDR=
#CHAIN_EIP155_5042_RELAYER_KEY=
#CHAIN_EIP155_5042_SWEEP_ENABLED=false
#CHAIN_EIP155_5042_DISPUTE_ADMIN_ADDR=
#
# --- eip155:16661 (0G mainnet — LIVE; TendaEscrow deployed 2026-09-03, #13) ---
# Values below are the deploy's own record, never typed by hand: address, tx
# 0xe58e6009e5f8b6e7855e09aecf7a14af0919a9f4aec723da58da55e9924b2fb1 and
# block from contracts/evm/broadcast/Deploy.s.sol/16661/run-latest.json;
# treasury and dispute admin READ BACK from the contract on 2026-09-08 (#79).
# USDC here is XSwap Bridged USDC (0x1f3AA822…473E), a real token and a manifest
# constant — not the Galileo mock, and not an env var. The chain registers only
# when RPC_URL + ESCROW_ADDR + TREASURY_ADDR are all set (the adapter gate).
#CHAIN_EIP155_16661_RPC_URL=https://evmrpc.0g.ai
#CHAIN_EIP155_16661_RPC_URL_FALLBACK=
#CHAIN_EIP155_16661_ESCROW_ADDR=0x9d0193f7b607a15079bfe29ae28d69044f62c391
#CHAIN_EIP155_16661_ESCROW_DEPLOY_BLOCK=43414017
#CHAIN_EIP155_16661_TREASURY_ADDR=0x8792ed02eb25BEC8a9E8AD96C48fDD08FA39fFb5
# Relayer hot wallet for agent funding (#18): sends createEscrowFor, pays its gas.
# 0x-hex private key, gas float only. Optional; unset = RELAY_UNAVAILABLE.
#CHAIN_EIP155_16661_RELAYER_KEY=
# Abandoned-escrow sweep (#43): pay gas from the relayer wallet above to refund
# creators who never came back for their own funds. DEFAULT OFF, and a separate
# switch from the key on purpose — relaying serves a flow an agent asked for,
# sweeping is an open-ended outflow on escrows nobody asked us to touch. Only
# 'true' or 'false'; anything else is a boot error naming the key. What the
# production deployment sets is not verified from this file (#79); `false` is
# the safe default and the one to keep unless the sweep has been decided on.
#CHAIN_EIP155_16661_SWEEP_ENABLED=false
# Native-gas seed (#53a): the hot wallet that pays each user's one-time OG
# grant when they CLAIM it — never auto-sent (#53c-2). 0x-hex private key, and
# its OWN wallet, never the relayer key above: that float serves a flow an
# agent asked for, this one is an open-ended outflow to every user who asks.
# Documented on every chain whose manifest gasPolicy is 'native-seed' (both 0G
# chains and both Solana chains); the loader would accept the var on any chain,
# but with no gasSeedAmountRaw declared it would fund nothing. Unset = seed
# dormant, and db:seed says so in its skipped list.
# The amount is justified HERE too (#77, 2026-09-08): mainnet's gas price was
# observed at ~3.9 gwei on evmrpc.0g.ai — below Galileo's — and is listed in
# OBSERVED_GAS_PRICE_WEI, so the figure measured on 16602 (#53b) holds.
#CHAIN_EIP155_16661_GAS_SEED_KEY=
#CHAIN_EIP155_16661_DISPUTE_ADMIN_ADDR=0x05A4750BC528e1Ff4A3d41540101537ac0500D28

# ---------------------------------------------------------------------------
# CORS (production: set both; unset = any origin, dev only)
# ---------------------------------------------------------------------------
# Comma-separated origins for the public API
#CORS_ORIGIN=https://app.tenda.example
# Admin panel origins — /v1/admin/* rejects browser requests from elsewhere
#ADMIN_ORIGIN=https://admin.tenda.example

# ---------------------------------------------------------------------------
# Mobile deep links
# ---------------------------------------------------------------------------
# SHA-256 cert fingerprint for Android App Links (assetlinks.json)
#ANDROID_SHA256_FINGERPRINT=AA:BB:CC:...

# ---------------------------------------------------------------------------
# Redis / BullMQ (#33). Unset = queue 501s and no workers start.
# ---------------------------------------------------------------------------
#REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Phone OTP SMS (#32). Provider selection (lib/onboarding-deps):
#   • Termii ONLY            → all SMS via Termii (NG/Africa).
#   • Twilio ONLY            → all SMS via Twilio (global).
#   • BOTH                   → numbers matching TERMII_COUNTRY_PREFIXES go to
#                              Termii (cheaper locally), everything else Twilio.
#   • NEITHER                → codes log to the console (dev mode); no real SMS.
# We keep our own code/hash/rate-limit/expiry, so Twilio is the Programmable
# SMS (/Messages) transport, NOT Twilio Verify.
# ---------------------------------------------------------------------------
#TERMII_API_KEY=
#TERMII_SENDER_ID=
# E.164 prefixes routed to Termii when BOTH providers are set (default +234):
#TERMII_COUNTRY_PREFIXES=+234
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_SMS_FROM=

# ---------------------------------------------------------------------------
# LLM moderation via OpenRouter (#56). Unset = keyword-only moderation.
# ---------------------------------------------------------------------------
#OPENROUTER_API_KEY=
#OPENROUTER_MODERATION_MODEL=anthropic/claude-haiku-4.5
#OPENROUTER_MODERATION_TIMEOUT_MS=6000
#OPENROUTER_MODERATION_MAX_OUTPUT_TOKENS=160

# ---------------------------------------------------------------------------
# Native push (#53). Unset = Expo push fallback.
# ---------------------------------------------------------------------------
# base64 of the Firebase service-account JSON (FCM HTTP v1)
#FCM_SERVICE_ACCOUNT_B64=
# APNs token auth (.p8 key, base64) — APNS_TOPIC is the iOS bundle id
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_PRIVATE_KEY_B64=
#APNS_TOPIC=com.tenda.app

# ---------------------------------------------------------------------------
# Fiat rails (#61). Feature gate defaults ON (p2p_internal always works);
# licensed providers register only when their keys exist.
# ---------------------------------------------------------------------------
#FIAT_RAILS_ENABLED=true
#YELLOWCARD_API_KEY=
#YELLOWCARD_API_SECRET=
#YELLOWCARD_WEBHOOK_SECRET=
#ONRAMPMONEY_API_KEY=
#ONRAMPMONEY_API_SECRET=
#ONRAMPMONEY_WEBHOOK_SECRET=
# NIP name-enquiry (bank-account verification). Reserved: vendor call
# lands with #61; accounts save unverified until then.
#NIP_API_KEY=

# ---------------------------------------------------------------------------
# Sentry error reporting (instrument.js). Unset = Sentry disabled.
# ---------------------------------------------------------------------------
#SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ---------------------------------------------------------------------------
# Admin dashboard login (#86/#89). Key unset: dev logs OTP codes; production
# answers 503 on send-email-otp until Resend is configured.
# ---------------------------------------------------------------------------
#RESEND_API_KEY=
#EMAIL_FROM=Tenda Admin <admin@tenda.app>
# Admin-dashboard JWT lifetime (own knob; mobile JWT_EXPIRES_IN stays 7d)
#ADMIN_JWT_EXPIRES_IN=12h
# Public base URL of the admin dashboard, used to link out-of-app alerts
# (dispute email/Slack) straight at the record. Unset = alerts send without a
# link. Must be an absolute http(s) URL when set, boot rejects a typo.
#ADMIN_DASHBOARD_URL=https://admin.tenda.app

# ---------------------------------------------------------------------------
# Slack webhooks (lib/slack). One incoming-webhook URL per named destination:
# SLACK_WEBHOOK_<DESTINATION>, matching a key in SLACK_DESTINATIONS. Unset =
# that destination stays quiet (Slack is optional); SET BUT MALFORMED fails at
# boot, because "silently mute" is the one thing an alert channel must not be.
#
# A destination is an AUDIENCE, not a topic, and each is configured
# INDEPENDENTLY: setting one and not the other silences only the alerts routed
# to the missing one, and the producer says so ('alert reached no channel').
# ---------------------------------------------------------------------------
# Channel the mediation team watches for newly raised disputes.
# Carries dispute context — escrow titles, reasons, party names — so point it
# at a PRIVATE channel.
#SLACK_WEBHOOK_DISPUTES=https://hooks.slack.com/services/T000/B000/xxxx
# Channel the operators of the hot wallets and chain rails watch.
# Today: a gas-seed funder down to 5 remaining grants or fewer. Whoever holds
# the GAS_SEED_KEY wallets above must be in this room — nobody else can act on
# it, and no mediator should have to read it to find their own work.
#SLACK_WEBHOOK_OPS=https://hooks.slack.com/services/T000/B000/yyyy

# ---------------------------------------------------------------------------
# Stage 9B — OAuth sign-in (Google / Apple). Comma-separated ACCEPTED
# audiences (id_token `aud`). Google issues tokens under the iOS/web/android
# client ID depending on the SDK config, so list every one you ship. Apple's
# aud is the app bundle ID (native) or Services ID (web). Unset = that
# provider's sign-in is not offered (verify → UNSUPPORTED_AUTH_METHOD).
# ---------------------------------------------------------------------------
#GOOGLE_OAUTH_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com
#APPLE_OAUTH_CLIENT_IDS=app.tenda.mobile,app.tenda.web

# ---------------------------------------------------------------------------
# Opt-in: apply pending SQL migrations at boot (lib/boot-migrate.ts). Advisory-
# locked, so multi-replica safe — concurrent boots serialize and no-op. Leave
# unset for migrate-then-roll deploys using the Dockerfile's migrate target.
# ---------------------------------------------------------------------------
#MIGRATE_ON_BOOT=true

# ---------------------------------------------------------------------------
# Opt-in: re-seed the chain/asset registry at boot (lib/boot-seed.ts), from the
# running process's own env and IDL. Same advisory lock as MIGRATE_ON_BOOT, and
# runs straight after it.
#
# Turn this on for push-button deploys. Without it the registry is written by a
# hand-run `pnpm db:seed`, which is how a deploy once seeded from an artifact
# OLDER than the server, wrote a superseded escrow address, and crash-looped on
# assertChainRegistryInSync. Seeding in-process makes that impossible: there is
# no second artifact to be stale.
# ---------------------------------------------------------------------------
#SEED_ON_BOOT=true

# ---------------------------------------------------------------------------
# Escape hatch for SEED_ON_BOOT, CHAINS. The seed disables every chain outside
# the active config. A chain is only ever outside it because its CHAIN_* vars
# are gone — which also means no adapter is built, so EVERY action on escrows
# there fails (accept, submit, approve, cancel, refund, dispute). The escrows
# still display; the funds are trapped until the vars come back. Boot refuses.
# Set this ONLY to retire a chain deliberately, or to roll back to a build with
# a narrower chain set. Chains with no unsettled escrows retire without it.
#
# Left ACTIVE at false rather than commented out, so the switch is visible to
# whoever copies this file: a commented-out hatch is one nobody finds at 3am.
# Only the exact lowercase string `true` acknowledges — `1`, `TRUE` and `yes`
# all still refuse the boot. Flip it for the one deploy that needs it, then
# put it back.
# ---------------------------------------------------------------------------
ALLOW_CHAIN_DISABLE=false

# ---------------------------------------------------------------------------
# Escape hatch for SEED_ON_BOOT, ASSETS. Losing a single input (e.g. a chain's
# USDC mint) retires just that asset. This is NOT the same harm: existing
# escrows still settle normally, because settlement never re-resolves the asset
# — only CREATION stops, and the asset disappears from the app. Boot still
# refuses, because silently ceasing to offer a token is worth a deliberate
# decision.
#
# Deliberately a SEPARATE flag from ALLOW_CHAIN_DISABLE: if one flag covered
# both, it would be set routinely for harmless asset changes and would then
# already be present on the day a chain disable is about to trap real money.
#
# Same convention as ALLOW_CHAIN_DISABLE above: active at false, exact
# lowercase `true` to acknowledge, and put it back afterwards.
# ---------------------------------------------------------------------------
ALLOW_ASSET_DISABLE=false
