{
  "name": "tenda-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm generate && tsc -b && vite build",
    "dev": "pnpm generate && vite",
    "gen:tokens": "pnpm --filter web exec tsx scripts/gen-web-tokens/main.ts --target docs",
    "gen:tokens:check": "pnpm --filter web exec tsx scripts/gen-web-tokens/main.ts --target docs --check",
    "generate": "pnpm gen:tokens && tsx scripts/generate-document.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm generate && vitest run",
    "test:coverage": "pnpm generate && vitest run --coverage",
    "type-check": "pnpm generate && tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tenda/api-doc": "workspace:*",
    "@tenda/shared": "workspace:*",
    "marked": "^18.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "license": "BUSL-1.1"
}
