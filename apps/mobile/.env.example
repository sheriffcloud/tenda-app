# ============================================================================
# Tenda mobile environment, copy to .env.local and fill in.
# Expo loads .env.local automatically; EXPO_PUBLIC_* vars are embedded in
# the JS bundle (never put secrets behind that prefix).
# ============================================================================

# REQUIRED, the API the app talks to (host only; routes carry /v1).
# The WebSocket URL is derived from this (http→ws + /v1/ws).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Public client RPCs only. Use independent providers for primary and fallback.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# EXPO_PUBLIC_SOLANA_RPC_URL_FALLBACK=

# Build profile: 'development' (default) | 'staging' | 'production'.
# Set via EAS build profiles in CI; drives Solana cluster + API selection.
#APP_ENV=development

# Path to google-services.json for FCM (defaults to ./google-services.json)
#GOOGLE_SERVICES_JSON=./google-services.json

# ---------------------------------------------------------------------------
# Google Sign-In (Stage 9B). USER-ACTION credentials minted in Google Cloud
# Console. Unset = Google sign-in fails cleanly (configureGoogleSignIn gets
# undefined) and the iOS URL-scheme plugin is skipped, so `expo config` / the
# dev loop still work without them.
#
# THREE OAuth clients in Google Console, but only TWO become env vars, the
# native @react-native-google-signin flow uses no browser redirect:
#
#   1. Web client    -> EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID below. Passed to
#      configure() on BOTH platforms and is the id_token `aud` the server
#      verifies, so it MUST also be in the server's GOOGLE_OAUTH_CLIENT_IDS.
#      Leave "Authorized JavaScript origins" AND "redirect URIs" BLANK, the
#      native SDK never redirects; those fields are for browser OAuth only
#      (this repo has none: admin login is email-OTP).
#   2. iOS client    -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID below. Create with
#      bundle ID `com.tendahq.mobile`.
#   3. Android client -> NO env var. Created with package `com.tendahq.mobile`
#      + the build's signing SHA-1; Google matches it by package+signature, so
#      it is never referenced by ID. Debug keystore
#      (android/app/debug.keystore, alias androiddebugkey, pass `android`)
#      SHA-1: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
#      Release/EAS builds sign with a DIFFERENT key, register that SHA-1 too.
#      Print it: keytool -list -v -keystore android/app/debug.keystore \
#        -alias androiddebugkey -storepass android
# ---------------------------------------------------------------------------
# Web OAuth client ID, used for id_token sign-in on both platforms.
#EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# iOS OAuth client ID (bundle ID com.tendahq.mobile).
#EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyyy.apps.googleusercontent.com
# Reversed iOS client ID (com.googleusercontent.apps.yyyy), build-time only;
# when set, adds the google-signin Expo plugin with this iOS URL scheme.
#GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.yyyy
# EXPO_PUBLIC_REOWN_PROJECT_ID=<id>
