# Tenda landing site — environment

# Base URL of the Tenda public API.
# Local dev (this machine):  http://127.0.0.1:3000
# Local dev (mobile/LAN):    http://<your-LAN-IP>:3000   (otherwise rate-strip fallback shows "—")
# Staging:                   https://api-staging.tenda.so
# Production:                https://api.tenda.so   (confirm before launch)
#
# Override per-machine in .env.development.local (gitignored).
VITE_API_BASE_URL=http://127.0.0.1:3000

# Origin of the Tenda web app (apps/web) — the navbar "Open Web App" link.
# Local dev:   http://localhost:3200   (pnpm --filter web dev)
# Preview:     https://dev-app.tendahq.com
# Production:  https://app.tendahq.com
#
# Vite inlines this at BUILD time, so it must be set per Vercel environment
# (Production / Preview / Development) — not once globally.
VITE_WEB_APP_URL=http://localhost:3200
